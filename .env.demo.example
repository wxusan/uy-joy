# Demo instance env overlay. Copy into a dedicated demo deployment/database only.

CLIENT_SLUG="mirabad-heights-demo"
CLIENT_PLATFORM_PLAN="full_sales_platform"
NEXT_PUBLIC_CLIENT_BRAND_NAME="Mirabad Heights"
CLIENT_COMPANY_LEGAL_NAME="Mirabad Heights Demo LLC"
NEXT_PUBLIC_CLIENT_PRIMARY_COLOR="#0f172a"
NEXT_PUBLIC_CLIENT_SECONDARY_COLOR="#f8fafc"
NEXT_PUBLIC_CLIENT_ACCENT_COLOR="#c0842f"
NEXT_PUBLIC_CLIENT_PHONE_NUMBER="+998 77 410 70 70"
NEXT_PUBLIC_CLIENT_TELEGRAM_URL="https://t.me/mirabad_demo_sales"
NEXT_PUBLIC_CLIENT_INSTAGRAM_URL="https://instagram.com/mirabad.demo"
NEXT_PUBLIC_CLIENT_SALES_OFFICE_ADDRESS="Tashkent, Mirabad district, Nukus street 17"
NEXT_PUBLIC_CLIENT_SALES_HOURS_LABEL="Mon-Sat, 09:00-19:00"
NEXT_PUBLIC_POWERED_BY_UY_JOY="true"
CLIENT_USER_LIMIT="20"
CLIENT_PROJECT_LIMIT="5"
CLIENT_FEATURE_FLAGS='{"sms":"add_on","instagram":"add_on","calling":"add_on","aiAssistant":"basic","customerPortal":"add_on","brokerPortal":"add_on"}'

# Never point these at a paid client production database.
DEMO_DATABASE_CONFIRM="demo"
DEMO_SEND_TELEGRAM="false"

