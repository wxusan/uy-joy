# Copy this to .env.local for development or into the deployment provider for production.

# Core deployment
NODE_ENV="development"
APP_VERSION="0.1.0"
NEXT_PUBLIC_APP_VERSION="0.1.0"
CLIENT_SLUG="client-slug"
CLIENT_PLATFORM_PLAN="real_estate_crm_growth"
CLIENT_PUBLIC_DOMAIN="http://localhost:3000"
CLIENT_ADMIN_URL="http://localhost:3000/portal/management-x7k9"

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Scheduled jobs - send as x-cron-secret or Authorization: Bearer
CRON_SECRET="replace-with-strong-random-cron-secret"

# White-label company and public brand
CLIENT_COMPANY_LEGAL_NAME="Client LLC"
NEXT_PUBLIC_CLIENT_BRAND_NAME="Client Residence"
NEXT_PUBLIC_CLIENT_LOGO_URL=""
NEXT_PUBLIC_CLIENT_FAVICON_URL=""
NEXT_PUBLIC_CLIENT_PRIMARY_COLOR="#111827"
NEXT_PUBLIC_CLIENT_SECONDARY_COLOR="#f8fafc"
NEXT_PUBLIC_CLIENT_ACCENT_COLOR="#16a34a"
NEXT_PUBLIC_POWERED_BY_UY_JOY="false"
NEXT_PUBLIC_DEFAULT_LOCALE="uz"
NEXT_PUBLIC_ENABLED_LOCALES="uz,ru,en"
NEXT_PUBLIC_CLIENT_PHONE_NUMBER="+998901234567"
NEXT_PUBLIC_CLIENT_TELEGRAM_URL="https://t.me/client"
NEXT_PUBLIC_CLIENT_INSTAGRAM_URL=""
NEXT_PUBLIC_CLIENT_SALES_OFFICE_ADDRESS=""
NEXT_PUBLIC_CLIENT_SALES_HOURS_LABEL=""
CLIENT_USER_LIMIT="10"
CLIENT_PROJECT_LIMIT="2"
CLIENT_ALLOW_AGENT_CLAIM="true"
CLIENT_FEATURE_FLAGS="{}"
CLIENT_EMBED_FRAME_ANCESTORS=""
UY_JOY_SUPPORT_CONTACT="support@example.com"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Telegram lead bot / outbox
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_SALES_CHAT_ID=""
TELEGRAM_DIRECTOR_CHAT_ID=""
TELEGRAM_FINANCE_CHAT_ID=""
# Comma-separated user IDs to exclude from manager inactivity alerts.
CRM_INACTIVITY_ALERTS_DISABLED_USER_IDS=""

# Weekly digest email delivery (Resend)
RESEND_API_KEY=""
REPORT_DIGEST_EMAIL_FROM="reports@example.com"
REPORT_DIGEST_EMAIL_TO="owner@example.com,sales@example.com"
ALERT_EMAIL_TO="support@example.com"

# First admin bootstrap script
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="ChangeMe12345"
ADMIN_NAME="Client Owner"
ADMIN_ROLE="owner"

# Optional AI / messaging / social integrations
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM=""
META_APP_ID=""
META_APP_SECRET=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
