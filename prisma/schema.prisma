generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  password                String
  name                    String
  role                    String                   @default("admin")
  createdAt               DateTime                 @default(now())
  isActive                Boolean                  @default(true)
  phone                   String?
  avatarUrl               String?
  lastLoginAt             DateTime?
  activitiesAuthored      Activity[]               @relation("ActivityActor")
  activitiesAssigned      Activity[]               @relation("ActivityAssignedTo")
  adSpends                AdSpend[]                @relation("AdSpendCreatedBy")
  assignedClients         Client[]                 @relation("ClientAssignedTo")
  createdClients          Client[]                 @relation("ClientCreatedBy")
  dealsAssigned           Deal[]                   @relation("DealAssignedTo")
  dealsCreated            Deal[]                   @relation("DealCreatedBy")
  discountsApproved       Deal[]                   @relation("DealDiscountApprovedBy")
  documentsReviewed       Document[]               @relation("DocumentReviewedBy")
  documentsUploaded       Document[]               @relation("DocumentUploadedBy")
  assignedLeads           Lead[]                   @relation("LeadAssignedTo")
  changedStageHistory     LeadStageHistory[]       @relation("LeadStageChangedBy")
  paymentPlansCreated     PaymentPlan[]            @relation("PaymentPlanCreatedBy")
  refundsApproved         Refund[]                 @relation("RefundApprovedBy")
  refundsRequested        Refund[]                 @relation("RefundRequestedBy")
  salesAgentProfile       SalesAgentProfile?
  tasksAssigned           Task[]                   @relation("TaskAssignedTo")
  tasksCreated            Task[]                   @relation("TaskCreatedBy")
  platformSettingsUpdates PlatformSettingsRecord[] @relation("PlatformSettingsUpdatedBy")
  reportDigestPreference  ReportDigestPreference?
  qualificationsUpdated   ClientQualification[]    @relation("ClientQualificationUpdatedBy")
  interestedUnitsAdded    ClientInterestedUnit[]   @relation("ClientInterestedUnitAddedBy")
}

model Project {
  id                      String            @id @default(cuid())
  name                    String
  nameTranslations        String?
  description             String?
  descriptionTranslations String?
  address                 String?
  addressTranslations     String?
  coverImage              String?
  topViewImage            String?
  latitude                Float?
  longitude               Float?
  infrastructure          Json?
  createdAt               DateTime          @default(now())
  expectedYear            Int?
  brandLogo               String?
  domain                  String?           @unique
  instagramUrl            String?
  masterPlanImage         String?
  phoneNumber             String?
  salesDaysJson           String?
  salesHoursEnd           String?
  salesHoursStart         String?
  salesOfficeAddress      String?
  slug                    String?           @unique
  telegramUrl             String?
  analyticsEvents         AnalyticsEvent[]
  buildings               Building[]
  deals                   Deal[]
  publicPageConfig        PublicPageConfig?
}

model Building {
  id               String   @id @default(cuid())
  name             String
  nameTranslations String?
  projectId        String
  frontViewImage   String?
  backViewImage    String?
  leftViewImage    String?
  rightViewImage   String?
  polygonData      Json?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  labelX           Float?
  labelY           Float?
  pointX           Float?
  pointY           Float?
  labelScale       Float?
  completionYear   Int?
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floors           Floor[]

  @@index([projectId])
}

model Floor {
  id             String   @id @default(cuid())
  number         Int
  buildingId     String
  basePricePerM2 Float?
  floorPlanImage String?
  positionData   Json?
  createdAt      DateTime @default(now())
  building       Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units          Unit[]

  @@index([buildingId])
}

model Unit {
  id                      String                 @id @default(cuid())
  unitNumber              String
  floorId                 String
  rooms                   Int
  area                    Float
  status                  String                 @default("available")
  pricePerM2              Float?
  totalPrice              Float?
  polygonData             Json?
  labelX                  Float?
  labelY                  Float?
  sketchImage             String?
  sketchImage2            String?
  sketchImage3            String?
  sketchImage4            String?
  description             String?
  descriptionTranslations String?
  features                Json?
  customerName            String?
  customerPhone           String?
  customerNotes           String?
  statusChangedAt         DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  currentDealId           String?
  reservedByClientId      String?
  soldToClientId          String?
  reservedAt              DateTime?
  soldAt                  DateTime?
  reservationExpiresAt    DateTime?
  activities              Activity[]
  analyticsEvents         AnalyticsEvent[]
  primaryDeals            Deal[]                 @relation("DealPrimaryUnit")
  dealUnits               DealUnit[]
  documents               Document[]
  tasks                   Task[]
  interestedClients       ClientInterestedUnit[]
  currentDeal             Deal?                  @relation("UnitCurrentDeal", fields: [currentDealId], references: [id])
  floor                   Floor                  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  reservedByClient        Client?                @relation("UnitReservedByClient", fields: [reservedByClientId], references: [id])
  soldToClient            Client?                @relation("UnitSoldToClient", fields: [soldToClientId], references: [id])

  @@index([floorId])
  @@index([status])
  @@index([currentDealId])
  @@index([reservedByClientId])
  @@index([soldToClientId])
  @@index([reservationExpiresAt])
}

model Lead {
  id                    String                    @id @default(cuid())
  name                  String
  phone                 String
  projectId             String?
  projectName           String?
  unitId                String?
  unitNumber            String?
  status                String                    @default("new")
  notes                 String?
  createdAt             DateTime                  @default(now())
  source                String?
  assignedTo            String?
  nextFollowUp          DateTime?
  buildingNameSnapshot  String?
  floorNumberSnapshot   Int?
  unitAreaSnapshot      Float?
  unitNumberSnapshot    String?
  unitPriceSnapshot     Float?
  unitRoomsSnapshot     Int?
  clientId              String?
  assignedToId          String?
  sourceDetail          String?
  campaign              String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  utmTerm               String?
  lostReason            String?
  lastActivityAt        DateTime?
  lastContactedAt       DateTime?
  nextActionAt          DateTime?
  closedAt              DateTime?
  convertedAt           DateTime?
  stageEnteredAt        DateTime                  @default(now())
  firstResponseAt       DateTime?
  updatedAt             DateTime                  @updatedAt
  referrer              String?
  landingPath           String?
  preferredLanguage     String?
  activities            Activity[]
  analyticsEvents       AnalyticsEvent[]
  deals                 Deal[]
  documents             Document[]
  assignedToUser        User?                     @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  client                Client?                   @relation(fields: [clientId], references: [id])
  stageHistory          LeadStageHistory[]
  tasks                 Task[]
  telegramNotifications TelegramNotificationLog[]
  interestedUnits       ClientInterestedUnit[]

  @@index([clientId])
  @@index([projectId])
  @@index([unitId])
  @@index([assignedToId])
  @@index([status, createdAt(sort: Desc)])
  @@index([nextActionAt])
  @@index([lastActivityAt])
}

model Client {
  id                    String                    @id @default(cuid())
  fullName              String
  phone                 String
  phoneNormalized       String?
  secondaryPhone        String?
  email                 String?
  telegramUsername      String?
  instagramUsername     String?
  preferredLanguage     String?
  type                  String                    @default("individual")
  companyName           String?
  source                String?
  notes                 String?
  status                String                    @default("active")
  createdById           String?
  assignedToId          String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  activities            Activity[]
  analyticsEvents       AnalyticsEvent[]
  assignedTo            User?                     @relation("ClientAssignedTo", fields: [assignedToId], references: [id])
  createdBy             User?                     @relation("ClientCreatedBy", fields: [createdById], references: [id])
  deals                 Deal[]
  documents             Document[]
  leads                 Lead[]
  payments              Payment[]
  refunds               Refund[]
  tasks                 Task[]
  telegramNotifications TelegramNotificationLog[]
  reservedUnits         Unit[]                    @relation("UnitReservedByClient")
  soldUnits             Unit[]                    @relation("UnitSoldToClient")
  qualification         ClientQualification?
  interestedUnits       ClientInterestedUnit[]

  @@index([phoneNormalized])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
}

model PublicPageConfig {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  brandName             String?
  logoUrl               String?
  faviconUrl            String?
  primaryColor          String   @default("#c66348")
  secondaryColor        String   @default("#15120f")
  accentColor           String   @default("#f0a383")
  backgroundColor       String   @default("#f4efe7")
  textColor             String   @default("#15120f")
  fontMode              String   @default("default")
  heroTitleJson         Json?
  heroSubtitleJson      Json?
  heroImageUrl          String?
  heroVideoUrl          String?
  primaryCtaLabelJson   Json?
  secondaryCtaLabelJson Json?
  formTitleJson         Json?
  formSubtitleJson      Json?
  thankYouTitleJson     Json?
  thankYouMessageJson   Json?
  enabledSections       Json?
  designTokens          Json?
  embedAllowedOrigins   Json?
  redirectAfterSubmit   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model LeadSource {
  id                      String   @id @default(cuid())
  key                     String   @unique
  labelJson               Json?
  isSystem                Boolean  @default(false)
  isActive                Boolean  @default(true)
  defaultAssignedAgentId  String?
  defaultPipelineStageKey String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([isActive])
}

model TelegramNotificationLog {
  id                String    @id @default(cuid())
  leadId            String
  clientId          String?
  chatId            String?
  status            String    @default("pending")
  messageText       String
  ref               String?
  telegramMessageId String?
  errorMessage      String?
  attemptCount      Int       @default(0)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  client            Client?   @relation(fields: [clientId], references: [id])
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([clientId])
  @@index([status, nextAttemptAt])
  @@index([ref])
  @@index([createdAt])
}

model PlatformSettingsRecord {
  id                 String   @id
  clientSlug         String?
  companyLegalName   String?
  publicBrandName    String?
  showPoweredByUyJoy Boolean?
  logoUrl            String?
  faviconUrl         String?
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  defaultLocale      String?
  enabledLocalesJson Json?
  publicPhoneNumber  String?
  publicTelegramUrl  String?
  publicInstagramUrl String?
  salesOfficeAddress String?
  salesHoursLabel    String?
  plan               String?
  featureFlags       Json?
  userLimit          Int?
  projectLimit       Int?
  storageLabel       String?
  allowAgentClaim    Boolean?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  updatedBy          User?    @relation("PlatformSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model ReportDigestPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  enabled   Boolean  @default(true)
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled])
}

model ClientQualification {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  cityRegion            String?
  familySize            Int?
  roomCounts            Json?
  preferredBuilding     String?
  preferredFloorMin     Int?
  preferredFloorMax     Int?
  preferredView         String?
  preferredAreaMin      Float?
  preferredAreaMax      Float?
  budgetMin             Float?
  budgetMax             Float?
  paymentPreference     String?
  initialPaymentAmount  Float?
  monthlyPaymentComfort Float?
  installmentMonths     Int?
  mortgageInterest      Boolean?
  subsidyInterest       Boolean?
  buyingPurpose         String?
  temperature           String?
  urgency               String?
  seriousnessLevel      String?
  decisionMaker         String?
  objection             String?
  competitorProjects    String?
  bestCallTime          String?
  preferredChannel      String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedBy             User?    @relation("ClientQualificationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([temperature])
  @@index([paymentPreference])
  @@index([budgetMax])
  @@index([updatedById])
}

model ClientInterestedUnit {
  id            String   @id @default(cuid())
  clientId      String
  unitId        String
  leadId        String?
  interestLevel String   @default("interested")
  note          String?
  addedById     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  addedBy       User?    @relation("ClientInterestedUnitAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([clientId, unitId])
  @@index([clientId])
  @@index([unitId])
  @@index([leadId])
  @@index([addedById])
}

model PipelineStage {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  sortOrder          Int
  color              String?
  probabilityPercent Int?
  isDefault          Boolean  @default(false)
  isWon              Boolean  @default(false)
  isLost             Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model LeadStageHistory {
  id              String    @id @default(cuid())
  leadId          String
  fromStatus      String?
  toStatus        String
  changedById     String?
  enteredAt       DateTime  @default(now())
  leftAt          DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  changedBy       User?     @relation("LeadStageChangedBy", fields: [changedById], references: [id])
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([toStatus])
  @@index([enteredAt])
  @@index([leftAt])
}

model Activity {
  id           String   @id @default(cuid())
  type         String
  title        String
  body         String?
  clientId     String?
  leadId       String?
  unitId       String?
  dealId       String?
  taskId       String?
  actorId      String?
  assignedToId String?
  direction    String?
  channel      String?
  metadata     Json?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  actor        User?    @relation("ActivityActor", fields: [actorId], references: [id])
  assignedTo   User?    @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])
  client       Client?  @relation(fields: [clientId], references: [id])
  deal         Deal?    @relation(fields: [dealId], references: [id])
  lead         Lead?    @relation(fields: [leadId], references: [id])
  task         Task?    @relation("TaskActivities", fields: [taskId], references: [id])
  unit         Unit?    @relation(fields: [unitId], references: [id])

  @@index([clientId])
  @@index([leadId])
  @@index([unitId])
  @@index([dealId])
  @@index([taskId])
  @@index([actorId])
  @@index([type])
  @@index([channel])
  @@index([occurredAt])
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  type         String     @default("call")
  status       String     @default("open")
  priority     String     @default("normal")
  clientId     String?
  leadId       String?
  dealId       String?
  unitId       String?
  assignedToId String
  createdById  String?
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  activities   Activity[] @relation("TaskActivities")
  assignedTo   User       @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  client       Client?    @relation(fields: [clientId], references: [id])
  createdBy    User?      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  deal         Deal?      @relation(fields: [dealId], references: [id])
  lead         Lead?      @relation(fields: [leadId], references: [id])
  unit         Unit?      @relation(fields: [unitId], references: [id])

  @@index([clientId])
  @@index([leadId])
  @@index([dealId])
  @@index([unitId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
}

model SalesAgentProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  displayName          String
  phone                String?
  telegramUsername     String?
  avatarUrl            String?
  isVisibleInReports   Boolean  @default(true)
  monthlyTargetDeals   Int?
  monthlyTargetRevenue Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deal {
  id                            String        @id @default(cuid())
  dealNumber                    String        @unique
  clientId                      String
  leadId                        String?
  projectId                     String?
  primaryUnitId                 String?
  assignedToId                  String?
  createdById                   String?
  status                        String        @default("draft")
  source                        String?
  currency                      String        @default("USD")
  displayCurrency               String        @default("USD")
  paymentCurrency               String        @default("UZS")
  exchangeRateToPaymentCurrency Float?
  exchangeRateLockedAt          DateTime?
  listPrice                     Float         @default(0)
  discountAmount                Float         @default(0)
  discountPercent               Float         @default(0)
  salePrice                     Float         @default(0)
  discountFlaggedAt             DateTime?
  discountApprovedById          String?
  discountApprovedAt            DateTime?
  initialPaymentAmount          Float         @default(0)
  initialPaymentPercent         Float         @default(0)
  remainingAmount               Float         @default(0)
  paymentTermMonths             Int           @default(0)
  monthlyPaymentAmount          Float         @default(0)
  expectedCloseAt               DateTime?
  reservedAt                    DateTime?
  reservationExpiresAt          DateTime?
  contractedAt                  DateTime?
  soldAt                        DateTime?
  lostAt                        DateTime?
  lostReason                    String?
  notes                         String?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  activities                    Activity[]
  assignedTo                    User?         @relation("DealAssignedTo", fields: [assignedToId], references: [id])
  client                        Client        @relation(fields: [clientId], references: [id])
  createdBy                     User?         @relation("DealCreatedBy", fields: [createdById], references: [id])
  discountApprovedBy            User?         @relation("DealDiscountApprovedBy", fields: [discountApprovedById], references: [id])
  lead                          Lead?         @relation(fields: [leadId], references: [id])
  primaryUnit                   Unit?         @relation("DealPrimaryUnit", fields: [primaryUnitId], references: [id])
  project                       Project?      @relation(fields: [projectId], references: [id])
  dealUnits                     DealUnit[]
  documents                     Document[]
  payments                      Payment[]
  paymentPlans                  PaymentPlan[]
  refunds                       Refund[]
  tasks                         Task[]
  currentUnits                  Unit[]        @relation("UnitCurrentDeal")

  @@index([clientId])
  @@index([leadId])
  @@index([projectId])
  @@index([primaryUnitId])
  @@index([assignedToId])
  @@index([status])
  @@index([reservationExpiresAt])
  @@index([createdAt])
}

model DealUnit {
  id          String   @id @default(cuid())
  dealId      String
  unitId      String
  priceAtDeal Float
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  unit        Unit     @relation(fields: [unitId], references: [id])

  @@unique([dealId, unitId])
  @@index([dealId])
  @@index([unitId])
}

model PaymentPlan {
  id                   String    @id @default(cuid())
  dealId               String
  name                 String
  type                 String    @default("installment")
  totalAmount          Float
  initialPaymentAmount Float     @default(0)
  remainingAmount      Float     @default(0)
  termMonths           Int       @default(0)
  startsAt             DateTime?
  scheduleJson         Json?
  status               String    @default("draft")
  notes                String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  payments             Payment[]
  createdBy            User?     @relation("PaymentPlanCreatedBy", fields: [createdById], references: [id])
  deal                 Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([status])
  @@index([createdById])
}

model Payment {
  id                            String      @id @default(cuid())
  paymentPlanId                 String
  dealId                        String
  clientId                      String
  sequence                      Int
  label                         String
  dueDate                       DateTime
  expectedAmount                Float
  expectedAmountPaymentCurrency Float?
  exchangeRate                  Float?
  paidAmount                    Float       @default(0)
  paidAmountPaymentCurrency     Float?
  status                        String      @default("scheduled")
  paidAt                        DateTime?
  method                        String?
  receiptDocumentId             String?
  notes                         String?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt
  documents                     Document[]  @relation("DocumentPayment")
  client                        Client      @relation(fields: [clientId], references: [id])
  deal                          Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  paymentPlan                   PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  receiptDocument               Document?   @relation("PaymentReceiptDocument", fields: [receiptDocumentId], references: [id])
  refunds                       Refund[]

  @@unique([paymentPlanId, sequence])
  @@index([paymentPlanId])
  @@index([dealId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([receiptDocumentId])
}

model Refund {
  id            String    @id @default(cuid())
  dealId        String
  paymentId     String?
  clientId      String
  amount        Float
  currency      String    @default("USD")
  reason        String
  status        String    @default("requested")
  requestedById String?
  approvedById  String?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  approvedBy    User?     @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  client        Client    @relation(fields: [clientId], references: [id])
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  payment       Payment?  @relation(fields: [paymentId], references: [id])
  requestedBy   User?     @relation("RefundRequestedBy", fields: [requestedById], references: [id])

  @@index([dealId])
  @@index([paymentId])
  @@index([clientId])
  @@index([status])
}

model Document {
  id              String    @id @default(cuid())
  clientId        String?
  leadId          String?
  dealId          String?
  unitId          String?
  paymentId       String?
  uploadedById    String?
  reviewedById    String?
  type            String
  title           String
  fileUrl         String
  fileName        String?
  fileSize        Int?
  mimeType        String?
  status          String    @default("uploaded")
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          Client?   @relation(fields: [clientId], references: [id])
  deal            Deal?     @relation(fields: [dealId], references: [id])
  lead            Lead?     @relation(fields: [leadId], references: [id])
  payment         Payment?  @relation("DocumentPayment", fields: [paymentId], references: [id])
  reviewedBy      User?     @relation("DocumentReviewedBy", fields: [reviewedById], references: [id])
  unit            Unit?     @relation(fields: [unitId], references: [id])
  uploadedBy      User?     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  receiptPayments Payment[] @relation("PaymentReceiptDocument")

  @@index([clientId])
  @@index([leadId])
  @@index([dealId])
  @@index([unitId])
  @@index([paymentId])
  @@index([uploadedById])
  @@index([reviewedById])
  @@index([type])
  @@index([status])
}

model AdSpend {
  id          String   @id @default(cuid())
  source      String
  campaign    String?
  periodStart DateTime
  periodEnd   DateTime
  amount      Float
  currency    String   @default("USD")
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("AdSpendCreatedBy", fields: [createdById], references: [id])

  @@index([source])
  @@index([campaign])
  @@index([periodStart, periodEnd])
  @@index([createdById])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  source      String?
  campaign    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  projectId   String?
  unitId      String?
  leadId      String?
  clientId    String?
  distinctId  String?
  sessionId   String?
  landingPath String?
  referrer    String?
  locale      String?
  properties  Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  client      Client?  @relation(fields: [clientId], references: [id])
  lead        Lead?    @relation(fields: [leadId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  unit        Unit?    @relation(fields: [unitId], references: [id])

  @@index([eventName, occurredAt])
  @@index([source, occurredAt])
  @@index([campaign, occurredAt])
  @@index([utmCampaign, occurredAt])
  @@index([projectId, occurredAt])
  @@index([unitId, occurredAt])
  @@index([leadId])
  @@index([clientId])
  @@index([sessionId, occurredAt])
}

model HeroImage {
  id        String   @id @default(cuid())
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model FAQ {
  id         String   @id @default(cuid())
  questionUz String
  questionEn String
  questionRu String
  answerUz   String
  answerEn   String
  answerRu   String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}
